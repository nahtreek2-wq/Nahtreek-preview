# Preview (staging) backend env. Copy to .env and fill with staging values.
# Deploys (Vercel preview project) must set the same vars as env.
APP_ENV=preview
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:5432/nahtreek_preview
DATABASE_POOL_MODE=transaction
JWT_SECRET=<staging-jwt-secret-min-32-chars>
# Pepper for stored OTP hashes (falls back to JWT_SECRET when unset).
OTP_SECRET=<staging-otp-secret-min-32-chars>
CORS_ORIGINS=http://localhost:3000,https://preview.nahtreek.example
SUPABASE_URL=https://STAGING_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<staging-supabase-service-role-key>
UPLOAD_DIR=./uploads
AI_PROVIDER_URL=https://api.groq.com/openai/v1
AI_PROVIDER_API_KEY=<groq-preview-key>
AI_MODEL=openai/gpt-oss-20b
AI_VISION_URL=
AI_VISION_MODEL=
AI_VISION_API_KEY=
RAZORPAY_KEY_ID=rzp_test_<staging-key-id>
RAZORPAY_KEY_SECRET=<staging-key-secret>
RAZORPAY_AI_PLAN_ID=plan_<staging-ai-plan-id>
RAZORPAY_MEMBERSHIP_PLAN_ID=plan_<staging-membership-plan-id>
RAZORPAY_WEBHOOK_SECRET=<staging-webhook-secret>
GEOAPIFY_API_KEY=<staging-geoapify-key>
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"<staging-project>", "...": "..."}
PUSH_ENABLED=false
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_FROM_NAME=Nahtreek Preview
SMS_PROVIDER=msg91
SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
PREVIEW_EMAIL_OTP_ENABLED=true
CRON_SECRET=<staging-cron-secret>
SEED_ENGINEER_PASSWORD=<local-seed-only>
JOURNEY_TIMINGS=
NAHTREEK_E2E_SCHEMA=
